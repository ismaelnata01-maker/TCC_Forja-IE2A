generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Funcionario {
  id         Int       @id @default(autoincrement())
  nome       String
  email      String    @unique
  cargo      String?
  nascimento DateTime?
  cpf        String    @unique
  senha      String
  telefone   String?
  endereco   String?
  desejos    ListaDesejos[]
  biblioteca Biblioteca[]
}

model Jogo {
  id             Int            @id @default(autoincrement())
  titulo         String
  descricao      String
  genero         String
  plataforma     String
  imagemUrl      String?
  anoLancamento  Int?
  preco          Float         @default(0)
  desejos        ListaDesejos[]
  biblioteca     Biblioteca[]
}

model ListaDesejos {
  funcionarioId Int
  jogoId        Int
  createdAt     DateTime @default(now())
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  jogo          Jogo        @relation(fields: [jogoId], references: [id], onDelete: Cascade)

  @@id([funcionarioId, jogoId])
}

model Biblioteca {
  funcionarioId Int
  jogoId        Int
  horasJogadas   Float    @default(0)
  status         String   @default("NAO_INICIADO")
  conquistas     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  funcionario    Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  jogo           Jogo        @relation(fields: [jogoId], references: [id], onDelete: Cascade)

  @@id([funcionarioId, jogoId])
}
